# Web Server
APP_NAME=Smart Pantry API
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=postgresql+psycopg://smartpantry_user:smartpantry_password@localhost:5432/smartpantry_db

JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173

VITE_API_BASE_URL=http://localhost:8000


# Email Provider
# EMAIL_PROVIDER 切換模式 (手動更改設定)
# fake - 不寄真信
# gmail_smtp - 少量真實寄送
# production - 給正式 provider 用
EMAIL_PROVIDER=fake
EMAIL_FROM_NAME=Smart Pantry
EMAIL_FROM_ADDRESS=google_mail@example.com

# 用 Gmail 少量真實寄送
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USERNAME=google_mail@gmail.com
GMAIL_SMTP_APP_PASSWORD=Google 帳號產生_應用程式密碼

# 給正式 provider 用
PRODUCTION_EMAIL_PROVIDER=resend
RESEND_API_KEY=你的-resend-api-key
SENDGRID_API_KEY=
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=


# AI Server
AI_SERVER_HOST=0.0.0.0
AI_SERVER_PORT=8100
AI_WORKER_POLL_INTERVAL_SECONDS=5
AI_WORKER_BATCH_SIZE=1
AI_WORKER_JOB_TYPES=recipe_recommendation
AI_JOB_TIMEOUT_SECONDS=300
AI_VISION_TIMEOUT_SECONDS=60
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_BASE_URL=
OLLAMA_VISION_BASE_URL=
LLM_TEXT_MODEL=qwen2.5:7b
LLM_VISION_MODEL=qwen3-vl:8b
