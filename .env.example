# Web Server
APP_NAME=Smart Pantry API
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=postgresql+psycopg://smartpantry_user:smartpantry_password@localhost:5432/smartpantry_db

JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173

VITE_API_BASE_URL=http://localhost:8000


# EMAIL_PROVIDER 切換模式 (手動切換設定)
# fake - 測試用不會實際發送信件，顯示在設定分頁中
# gmail_smtp - 實際發送信件 (開發時測試用帳號)
# production - 正式環境發送設定 provider 用
EMAIL_PROVIDER=fake
EMAIL_FROM_NAME=Smart Pantry
EMAIL_FROM_ADDRESS=no-reply@example.com

GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USERNAME=YOUR_GMAIL@gmail.com
GMAIL_SMTP_APP_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# 三種正式 PRODUCTION_EMAIL_PROVIDER (手動切換設定)
# PRODUCTION_EMAIL_PROVIDER 可選：resend / sendgrid / ses
# 只需要填入目前選用 provider 對應的 secret，不需要三組都填。
PRODUCTION_EMAIL_PROVIDER=resend
# RESEND only
RESEND_API_KEY=-YOUR_RESEND_API_KEY
# SENDGRID only
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
# AWS_SES only
AWS_SES_REGION=YOUR_AWS_SES_REGIONY
AWS_SES_ACCESS_KEY_ID=YOUR_AWS_SES_ACCESS_KEY_ID
AWS_SES_SECRET_ACCESS_KEY=YOUR_AWS_SES_SECRET_ACCESS_KEY


# AI Server
AI_SERVER_HOST=0.0.0.0
AI_SERVER_PORT=8100
AI_WORKER_POLL_INTERVAL_SECONDS=5
AI_WORKER_BATCH_SIZE=1
AI_WORKER_JOB_TYPES=recipe_recommendation
AI_JOB_TIMEOUT_SECONDS=300
AI_VISION_TIMEOUT_SECONDS=60
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_BASE_URL=
OLLAMA_VISION_BASE_URL=
LLM_TEXT_MODEL=qwen2.5:7b
LLM_VISION_MODEL=qwen3-vl:8b
